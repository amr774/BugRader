# Copy to .env. Use a dedicated database. Replace the placeholder password.
DATABASE_URL=postgresql://bugradar:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/bugradar?schema=public
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1
# Containers/platforms: set HOST=0.0.0.0; restrict access with the platform network.
NODE_ENV=development
# Ingestion credentials are project-specific, generated by project settings.
# Store server SDK credentials in the monitored backend's environment, not here.
# Set only for explicit development seed. Never use a production password.
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
